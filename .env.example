# 复制为 .env，填入与你的模型服务对应的实际值。真实 .env 不提交 Git。
# 不要给前端配置模型密钥。密钥只在后端运行时注入。
CHAT_MODEL_NAME=your-chat-model
CHAT_MODEL_PROVIDER=openai
CHAT_MODEL_BASE_URL=https://example.invalid/v1
CHAT_MODEL_API_KEY=replace-with-your-chat-api-key
CHAT_MODEL_USE_RESPONSES_API=false
CHAT_MODEL_TIMEOUT=60
CHAT_MODEL_MAX_RETRIES=0

EMBEDDING_MODEL_NAME=your-embedding-model
EMBEDDING_MODEL_PROVIDER=openai
EMBEDDING_MODEL_BASE_URL=https://example.invalid/v1
EMBEDDING_MODEL_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL_CHECK_EMBEDDING_CTX_LENGTH=false

# 留空时路由模型继承聊天模型连接信息。
ROUTER_MODEL_NAME=
ROUTER_MODEL_TIMEOUT=20
ROUTER_MODEL_MAX_RETRIES=0

# Compose 只把网页端口绑定到本机。可修改端口以避免冲突。
WEB_PORT=8080
